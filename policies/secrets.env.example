# Secrets — DO NOT COMMIT
#
# Copy this file to `secrets.env` (which is gitignored) and fill in.
# Loaded by the harness at boot. The LLM never sees this file directly.

# --- LLM providers ---
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Cloud chat model ---
# `gemini-flash-latest` currently aliases to `gemini-3-flash-preview` (Google
# may hot-swap with ~2 weeks notice). Pin via DISEASE360_MODEL_OVERRIDE for
# stability — recommended while Gemini 3 Flash is still labelled "preview".
GEMINI_DEFAULT_MODEL=gemini-flash-latest
DISEASE360_MODEL_OVERRIDE=gemini-3-flash-preview

# --- Dashboard voice (turn-based: STT -> chat agent -> TTS) ---
# Speech-to-text: any Gemini multimodal model that accepts audio Parts.
# Default uses Gemini 3 Flash for stronger noisy-mic understanding.
DISEASE360_VOICE_STT_MODEL=gemini-3-flash-preview
# Text-to-speech: hosts the prebuilt voice catalog (Algieba, Charon, etc.).
# Gemini 3.1 Flash TTS is the current preview; falls back here automatically
# if unset.
DISEASE360_VOICE_TTS_MODEL=gemini-3.1-flash-tts-preview
# Prebuilt voice name — see the Voices tab in the UI for samples.
# Defaults to Algieba (smooth baritone, JARVIS-like).
DISEASE360_VOICE_NAME=Algieba
# Lower = more deadpan/consistent cadence. Range 0.0–2.0. 0.6 suits JARVIS.
# (Currently unused by the TTS-only path, kept for compatibility.)
DISEASE360_VOICE_TEMPERATURE=0.6
# Pacing tag prepended to every TTS call as a Gemini audio tag. Gemini TTS
# has no numeric speaking-rate knob — pace is controlled via tags like
# `[fast]`, `[very fast]`, `[slow]`, or natural-language ("brisk"). The
# catch: the model treats this as *performance direction* and also lifts
# pitch / adds urgency, which breaks the smooth JARVIS baritone. Default
# is empty (native prosody); the client applies a small mechanical speed-
# up (~1.08x) instead. Set to `fast` etc. only if you want full model-
# level acceleration. Doesn't affect /voice/sample audition.
DISEASE360_VOICE_PACE=
# Fallback BCP-47 locale for TTS when the language detector finds no
# signal (e.g. the very first dashboard greeting before any user turn).
# Defaults to en-US. Set to ca-ES or es-ES to greet in Catalan/Spanish.
DISEASE360_VOICE_LANGUAGE_DEFAULT=en-US
# Hard pin: when set, every TTS call uses this locale regardless of the
# input text. Leave blank for per-message detection.
DISEASE360_VOICE_LANGUAGE_PIN=
# The JARVIS delivery persona (smooth baritone, dry wit, "Right away, sir.")
# is layered on top of the normal Disease360 system prompt for any voice turn —
# regardless of which page the request comes from. Typed chat keeps the
# neutral Disease360 voice. To tweak the persona, edit JARVIS_STYLE in
# services/harness/disease360_harness/voice.py.

# --- Local engine ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=gemma4:4b

# --- Google Workspace (Gmail + Calendar) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Web search ---
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# --- Vera (Databricks-served assistant) ---
# The "Vera" cockpit tab proxies turns through the harness to a Databricks
# Model Serving endpoint (an MLflow ResponsesAgent). The token stays
# server-side; the cockpit never sees it.
# Endpoint defaults to the genai-d360-assistant invocations URL; override only
# if the endpoint moves.
DATABRICKS_VERA_ENDPOINT=https://adb-3337810075168014.14.azuredatabricks.net/serving-endpoints/genai-d360-assistant/invocations
# Databricks Personal Access Token (PAT) with CAN_QUERY on the endpoint.
# Falls back to DATABRICKS_TOKEN if DATABRICKS_VERA_TOKEN is unset.
DATABRICKS_VERA_TOKEN=
DATABRICKS_TOKEN=

# --- Dashboard routing ---
# OpenRouteService API key — used by the dashboard `show_route` tool to draw
# Google-Maps-style polylines on the holographic globe. Free tier: ~2k req/day.
# Get one at https://openrouteservice.org/dev/#/signup. Leave blank to disable
# routing (the agent will narrate a graceful fallback).
DISEASE360_OPENROUTESERVICE_KEY=

# --- Harness ---
# Leave DISEASE360_HOME unset to default to repo root.
# DISEASE360_HOME=
DISEASE360_DEFAULT_BACKEND=gemini     # gemini | ollama
DISEASE360_USER_NAME=Bruno
DISEASE360_TIMEZONE=Europe/Madrid
DISEASE360_DND_START=01:00
DISEASE360_DND_END=07:00
DISEASE360_DIGEST_TIME=08:00
DISEASE360_APPROVAL_TIMEOUT_SECONDS=300

# --- Service ports ---
DISEASE360_MEMORY_URL=http://127.0.0.1:8001
DISEASE360_HARNESS_URL=http://127.0.0.1:8002

# --- Vault backend (ADR 0001 phase 2) ---
# `disk` keeps the legacy filesystem vault under vault/<brain>/ (Phase 1).
# `postgres` reads/writes Supabase Postgres under tenant RLS (target).
# Default: disk while phase 2 is rolling out; flip to postgres per service
# once phase 2.6 lands.
DISEASE360_VAULT_BACKEND=disk

# Supabase project credentials. Required when DISEASE360_VAULT_BACKEND=postgres.
# DB URL is the IPv4 pooler URL from Supabase dashboard → Connect → Connection
# pooling → "Session" mode (port 5432) for long-lived asyncpg pools.
DISEASE360_SUPABASE_DB_URL=
# Service-role key bypasses RLS — only the memory/harness services may load
# it. Never expose to the cockpit; never log.
DISEASE360_SUPABASE_SERVICE_ROLE_KEY=
# Bruno's tenant_id (auth.users.id). Used as the implicit tenant for local
# dev and CLI calls until per-user JWT plumbing lands in phase 4.
DISEASE360_DEV_TENANT_ID=
