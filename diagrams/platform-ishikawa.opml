<?xml version="1.0" encoding="UTF-8"?>
<!--
  Disease360 Platform - Ishikawa (Fishbone) outline.
  Import into XMind:  File > Import > OPML.
  Root = the platform (effect). Children = bones (platform pieces).
  The "Medical Deep Research (MVP)" bone nests the original 8-category fishbone.
  Tags: [WORKS] = shipped today, [PLANNED] = planned / blocker / vapor.
-->
<opml version="2.0">
  <head>
    <title>Disease360 Platform - Ishikawa Diagram</title>
  </head>
  <body>
    <outline text="Disease360 Platform (per-client AI workspace)">
      <outline text="1. Medical Deep Research (MVP) -- the nested fishbone">
        <outline text="1. Data &amp; Knowledge Foundation">
          <outline text="PubMed API integration for literature search"/>
          <outline text="KOLs (Key Opinion Leaders) -- minutes, metadata"/>
          <outline text="GlobalData (market &amp; competitor data)"/>
          <outline text="EMA (European Medicines Agency data)"/>
          <outline text="FDA (drug metadata, approvals)"/>
          <outline text="ClinicalTrials.gov (clinical trial data)"/>
          <outline text="BioNCP (genetic &amp; disease data)"/>
          <outline text="Real-time clinical trial updates &amp; global congress ingestion"/>
          <outline text="Intelligence &amp; news streaming"/>
          <outline text="Expanded data lakes incl. market access &amp; patent intelligence"/>
        </outline>
        <outline text="2. Orchestration &amp; Tools">
          <outline text="Regulatory intelligence extraction tools"/>
          <outline text="Clinical trial monitoring tools"/>
          <outline text="Competitor intelligence tools"/>
          <outline text="SQL-based &amp; structured queries"/>
          <outline text="Vector search"/>
          <outline text="Web search tool (news, abstracts, updates)"/>
          <outline text="Landscape visualization engines"/>
          <outline text="Predictive &amp; trend modeling tools"/>
          <outline text="Autonomous workflow execution"/>
          <outline text="EORs, reports &amp; dossiers"/>
        </outline>
        <outline text="3. Intelligence &amp; Reasoning Layer">
          <outline text="Multi-source synthesis &amp; conflict detection"/>
          <outline text="Cross-source comparison &amp; adaptive reasoning"/>
          <outline text="Evidence hierarchy &amp; confidence scoring"/>
          <outline text="Complex multi-hop reasoning across sources &amp; subagents"/>
          <outline text="Predictive insight generation"/>
          <outline text="Clinical trial trends"/>
          <outline text="Competitor evolution"/>
          <outline text="Market forecasting"/>
        </outline>
        <outline text="4. Trust, Transparency &amp; Governance">
          <outline text="Mandatory citations with inline links"/>
          <outline text="Data lineage tracking &amp; source-conflict detection"/>
          <outline text="Transparency in conflicts between sources"/>
          <outline text="Specific source referenced in citations"/>
          <outline text="No hallucination -- flags when evidence is insufficient"/>
          <outline text="Reliability score per source or claim"/>
          <outline text="Real-time feeds from congresses, publications, patents"/>
          <outline text="Global citation scoring for source reliability"/>
          <outline text="Alignment with AlphaSense &amp; Veeva for KOL/market research"/>
        </outline>
        <outline text="5. Domain Intelligence Subagents">
          <outline text="Autonomous execution of complex workflows (EORs, reports)"/>
          <outline text="Multi-agent coordination for patient journeys &amp; market access"/>
          <outline text="Specialized subagents: Market Access, Pricing, Patient Journey"/>
          <outline text="PubMed specialist"/>
          <outline text="KOLs specialist"/>
          <outline text="GlobalData specialist"/>
          <outline text="ClinicalTrials.gov specialist"/>
          <outline text="FDA &amp; EMA specialist"/>
          <outline text="Web search specialist"/>
        </outline>
        <outline text="6. Skills (Structured Analysis)">
          <outline text="Regulatory Intelligence Overview (full regulatory view of a drug)"/>
          <outline text="Treatment Landscape Synthesis (multi-source treatment data)"/>
          <outline text="KOL Intelligence Synthesis (expert opinions &amp; insights)"/>
          <outline text="Patient Funnel (volume &amp; treatment-share analysis)"/>
          <outline text="Bullseye Chart (competitor landscape, molecular-level)"/>
          <outline text="Diagrammatic / skill-based advanced visualizations"/>
          <outline text="Specialized skills per subagent with concrete process guidelines"/>
        </outline>
        <outline text="7. Query Understanding &amp; Knowledge Extraction">
          <outline text="Interpret highly domain-specific, complex medical queries"/>
          <outline text="Enhanced entity extraction (disease, drug, gene)"/>
          <outline text="Intent detection &amp; routing to the right subagent"/>
          <outline text="Extraction of key entities (disease, drug, country)"/>
          <outline text="Domain &amp; disease detection"/>
          <outline text="Decomposition of complex questions"/>
          <outline text="Requests clarification when it lacks information"/>
        </outline>
        <outline text="8. User Experience &amp; Outputs">
          <outline text="Interactive dashboards &amp; automated report generation"/>
          <outline text="Newsletters / alerts on new findings &amp; emerging trends"/>
          <outline text="Automated PPT/PDF reports with dynamic content"/>
          <outline text="Mermaid diagrams display"/>
          <outline text="Advanced exportable visualizations (charts, molecular Bullseye)"/>
          <outline text="Inline citations &amp; references"/>
          <outline text="Markdown tables &amp; structured summaries (with citations)"/>
        </outline>
      </outline>
      <outline text="2. Memory &amp; Knowledge Vault">
        <outline text="[PLANNED] Postgres-canonical vault under RLS"/>
        <outline text="[WORKS] Brains -&gt; Pages model"/>
        <outline text="[WORKS] Wikilink graph (orphans / broken links)"/>
        <outline text="[WORKS] FTS full-text search (FTS5)"/>
        <outline text="[WORKS] Hot cache (~500 tokens, always loaded)"/>
        <outline text="[WORKS] Lint (schema &amp; integrity checks)"/>
        <outline text="[WORKS] Ingest / solve cycle (plan -&gt; approve -&gt; apply)"/>
        <outline text="[PLANNED] Immutable raw captures"/>
        <outline text="[WORKS] Markdown export / Obsidian"/>
      </outline>
      <outline text="3. Harness &amp; Agent Runtime">
        <outline text="[WORKS] Deep Agents on LangGraph"/>
        <outline text="[WORKS] SSE streaming chat"/>
        <outline text="[WORKS] Threads bound to a brain"/>
        <outline text="[WORKS] Single LLMClient (Gemini Flash + Ollama fallback)"/>
        <outline text="[WORKS] Per-turn tool budgets"/>
        <outline text="[WORKS] Prompt cache"/>
      </outline>
      <outline text="4. Approval Gate &amp; Governance">
        <outline text="[WORKS] HumanInTheLoop middleware"/>
        <outline text="[WORKS] Persisted SQLite approval queue (survives restarts)"/>
        <outline text="[WORKS] Multi-channel approval queue"/>
        <outline text="[WORKS] Audit log (logs/audit.jsonl)"/>
        <outline text="[WORKS] policies/actions.yaml (allow / require / never)"/>
        <outline text="[PLANNED] Tamper-evident hash-chaining"/>
        <outline text="[PLANNED] Network policy enforcement (network.yaml)"/>
      </outline>
      <outline text="5. Cockpit &amp; Channels">
        <outline text="[WORKS] React 19 + Vite cockpit"/>
        <outline text="[WORKS] Typer CLI (ask / approvals / brains / switch)"/>
        <outline text="[WORKS] Force-directed graph view (3D flashcard)"/>
        <outline text="[PLANNED] Voice STT / TTS"/>
        <outline text="[PLANNED] Gesture recognition pipeline"/>
        <outline text="[PLANNED] DND window / heartbeat scheduler"/>
      </outline>
      <outline text="6. Multi-tenancy &amp; Security">
        <outline text="[PLANNED] Supabase auth / JWT verified on backend"/>
        <outline text="[PLANNED] tenant_id scoping"/>
        <outline text="[PLANNED] RLS cross-tenant isolation"/>
        <outline text="[PLANNED] Secret redaction at model boundary"/>
        <outline text="[PLANNED] Hosted deploy / Docker / health checks"/>
        <outline text="[PLANNED] CI (GitHub Actions)"/>
      </outline>
      <outline text="7. OMNI (Meeting Intelligence) -- pharma meeting platform, nested">
        <outline text="1. Real-time Capture &amp; STT">
          <outline text="Live mic capture -&gt; WebSocket PCM streaming"/>
          <outline text="Real-time STT via Gemini Live (bidirectional)"/>
          <outline text="Batch STT fallback (3s PCM buffers)"/>
          <outline text="Hallucination filtering (drops filler outputs)"/>
          <outline text="Speaker extraction &amp; deduplication"/>
          <outline text="Upload mode (audio file or pasted transcript)"/>
        </outline>
        <outline text="2. Meeting Intelligence &amp; Analysis">
          <outline text="Live transcript with speaker labels"/>
          <outline text="AI-generated agenda / checklist from objectives"/>
          <outline text="Automatic checklist progress tracking"/>
          <outline text="Action items, decisions &amp; notes extraction"/>
          <outline text="Sentiment &amp; energy timeline"/>
          <outline text="Nudges (missing-topic suggestions)"/>
        </outline>
        <outline text="3. OMNI Voice Assistant">
          <outline text="'Hey OMNI' direct-address detection"/>
          <outline text="Mid-meeting Q&amp;A (Gemini, optional TOMMY context)"/>
          <outline text="Text-to-speech responses (Gemini TTS)"/>
          <outline text="End-of-meeting spoken summary"/>
        </outline>
        <outline text="4. TOMMY Diabetes Deep Agent">
          <outline text="Deep Agent on LangGraph (Gemini 2.5 Flash)"/>
          <outline text="BioMCP tools (PubMed, ClinicalTrials.gov, OpenFDA)"/>
          <outline text="Gene / variant / disease / drug lookups"/>
          <outline text="DuckDuckGo web_search fallback"/>
          <outline text="Streamed reasoning (per-tool NDJSON steps)"/>
          <outline text="Inline citations"/>
          <outline text="Chart generation (propose_chart -&gt; Recharts)"/>
        </outline>
        <outline text="5. Data &amp; Persistence">
          <outline text="SQLite meetings store"/>
          <outline text="TOMMY conversations as JSON files"/>
          <outline text="Queryable post-meeting document"/>
        </outline>
        <outline text="6. UX &amp; Frontend">
          <outline text="React 19 + Vite + TypeScript"/>
          <outline text="Cinematic landing with animated orb"/>
          <outline text="TommyOrb (Three.js) / VoiceOrb (mic-reactive)"/>
          <outline text="Recharts visualizations"/>
          <outline text="Markdown rendering (GFM tables)"/>
          <outline text="Light / dark theme"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
