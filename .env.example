# Disease360 Atlas — Environment variables
# Copy to .env for local development

# --- LLM (required for the local agent in harness) ---
GOOGLE_API_KEY=your_gemini_api_key_here

# --- Databricks SQL Warehouse (optional in local dev — memory returns empty data without it) ---
DATABRICKS_SERVER_HOSTNAME=adb-3337810075168014.14.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/YOUR_WAREHOUSE_ID
DATABRICKS_TOKEN=dapi_YOUR_TOKEN

# --- Unity Catalog ---
ATLAS_CATALOG=dev_gold_commercial
ATLAS_SCHEMA=genai_mcm_d360

# --- Vera Model Serving (optional — for the Vera tab) ---
DATABRICKS_VERA_ENDPOINT=https://adb-3337810075168014.14.azuredatabricks.net/serving-endpoints/genai-d360-assistant/invocations
DATABRICKS_VERA_TOKEN=dapi_YOUR_TOKEN

# --- Local dev ports (used by run.ps1) ---
ATLAS_MEMORY_PORT=8001
ATLAS_HARNESS_PORT=8002
