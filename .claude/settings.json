{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ruff check *)",
      "Bash(ruff format --check *)",
      "Bash(mypy *)",
      "Bash(pytest *)",
      "Bash(npx tsc *)",
      "Bash(npm run *)",
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(python -m pytest *)",
      "Bash(python scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git remote*)"
    ],
    "deny": [
      "Read(./policies/secrets.env)",
      "Read(./policies/secrets.local.*)",
      "Read(./.env)",
      "Read(./services/harness/data/**)",
      "Read(./services/memory/data/**)",
      "Read(./logs/*.jsonl)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)"
    ]
  }
}
